{
  "name": "hoist",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun --watch src/main.ts serve --data-dir .data",
    "start": "bun src/main.ts serve",
    "test": "bun test",
    "test:frontend": "node --experimental-vm-modules tests/frontend-dom.cjs",
    "check": "bun build src/main.ts --target=bun --outfile=/tmp/hoist-check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
